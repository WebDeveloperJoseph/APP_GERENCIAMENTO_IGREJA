generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Church {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // Ex: "igreja-central-picui"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos bi-direcionais ativos
  members      Member[]
  events       Event[]
  transactions Transaction[]
  assets       Asset[]

  @@map("churches")
}

model Member {
  id                 String    @id @default(uuid())
  name               String
  email              String?   @unique
  password           String?
  mustChangePassword Boolean   @default(false)
  phone              String?
  photoUrl           String?
  birthDate          DateTime?

  // 🔑 Multi-Tenant Opcional (Com a relação ativa para o validador aceitar)
  churchId String?
  church   Church? @relation(fields: [churchId], references: [id], onDelete: Cascade)

  role          Role          @default(MEMBRO)
  isSuperAdmin  Boolean       @default(false)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  createdEvents Event[]
  pushTokens    PushToken[]

  @@map("members")
}

model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  platform  String
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@map("push_tokens")
}

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String?
  location      String?
  coverImageUrl String?
  startDate     DateTime
  endDate       DateTime
  isPublic      Boolean  @default(true)

  // 🔑 Multi-Tenant Opcional
  churchId String?
  church   Church? @relation(fields: [churchId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   Member?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([createdById])
  @@map("events")
}

model Transaction {
  id          String              @id @default(uuid())
  type        TransactionType
  category    TransactionCategory
  value       Float
  date        DateTime            @default(now())
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  memberId    String?
  member      Member?             @relation(fields: [memberId], references: [id])

  // 🔑 Multi-Tenant Opcional para o Financeiro
  churchId String?
  church   Church? @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Asset {
  id              String      @id @default(uuid())
  name            String
  imageUrl        String?
  description     String?
  category        String
  value           Float
  acquisitionDate DateTime?
  location        String?
  status          AssetStatus @default(ATIVO)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // 🔑 Multi-Tenant Opcional para o Patrimônio
  churchId String?
  church   Church? @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("assets")
}

model StoredImage {
  id        String   @id @default(uuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@map("stored_images")
}

enum Role {
  MEMBRO
  VOLUNTARIO
  TESOUREIRO
  PASTOR
  DIRETOR_PATRIMONIO
  ADMIN
}

enum TransactionType {
  ENTRADA
  SAIDA
}

enum TransactionCategory {
  DIZIMO
  OFERTA
  ALUGUEL
  ENERGIA
  AGUA
  MANUTENCAO
  OUTROS
}

enum AssetStatus {
  ATIVO
  MANUTENCAO
  BAIXADO
}
